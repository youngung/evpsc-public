c-----------------------------------------------------------------------
c     Dimension of arrays. Reduntantly large size of arrays may impact
c     the computational speed of EVPSC-UMAT.
      include "parameters.dim"
c-----------------------------------------------------------------------
c     FE/IO input related condition (used in 'statev_io.f', 'umat.f'
c     ,'vumat.f', 'load_statev.f')
      integer is_initialized_statev
c-----------------------------------------------------------------------
c     AVERAGE
      real*8 SAV(6),dsav(6),SBAR(6),DSBAR(6),EPSTOT(3,3),EPSVM,EIJINCR,
     $     EVMINCR,TEMP,SVM,DVM,sbardot(6)
c-----------------------------------------------------------------------
